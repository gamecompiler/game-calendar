{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/subcal.html"
    },
    {
      "source": "/frame",
      "destination": "/subcal.html"
    },
    {
      "source": "/slide",
      "destination": "/slide.html"
    },
    {
      "source": "/slide/:id",
      "destination": "/slide.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PATCH,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization,Content-Type,Notion-Version,X-Slide-Key"
        }
      ]
    }
  ],
  "functions": {
    "api/notion.js": {
      "memory": 256
    },
    "api/notion-setup.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
